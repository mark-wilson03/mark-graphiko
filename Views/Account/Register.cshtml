@model MarkGraphiko.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Client Account | Mark Graphiko";
}

<div class="max-w-md mx-auto px-6 py-12 md:py-16">
    <div class="rounded-3xl p-8 sm:p-10 glass-panel shadow-2xl relative border border-slate-200 dark:border-white/10">
        
        <!-- Brand Header with Official Logo -->
        <div class="text-center mb-8">
            <img src="~/images/mark-graphiko-logo.png" alt="MARK GRAPHIKO" class="h-16 w-auto mx-auto object-contain rounded-xl shadow-lg mb-4" />
            <h1 class="text-2xl font-black uppercase text-slate-900 dark:text-white tracking-tight">
                Create Account
            </h1>
            <p class="text-xs text-amber-500 font-mono font-bold uppercase tracking-wider mt-0.5">
                Join MARK GRAPHIKO &bull; Where Art Meets Design
            </p>
        </div>

        <!-- Social Quick Connect -->
        <div class="space-y-3 mb-6">
            <form asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Google" />
                <button type="submit" class="w-full py-3.5 px-4 rounded-xl flex items-center justify-center gap-3 bg-white dark:bg-slate-800 border border-slate-300 dark:border-white/10 text-slate-700 dark:text-slate-200 text-xs font-bold uppercase tracking-wider hover:bg-slate-50 dark:hover:bg-slate-700 hover:border-indigo-500 transition-all shadow-sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    Sign Up with Google
                </button>
            </form>

            <form asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Facebook" />
                <button type="submit" class="w-full py-3.5 px-4 rounded-xl flex items-center justify-center gap-3 bg-[#1877F2] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#166fe5] transition-all shadow-sm">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                    Sign Up with Facebook
                </button>
            </form>
        </div>

        <div class="relative my-6">
            <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-300 dark:border-white/10"></div></div>
            <div class="relative flex justify-center text-[10px] uppercase font-mono"><span class="px-2 bg-slate-50 dark:bg-[#0f172a] text-slate-400">or sign up with number / email</span></div>
        </div>

        <form asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-rose-500"></div>

            <div>
                <label asp-for="FullName" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    Full Name *
                </label>
                <input asp-for="FullName" placeholder="e.g. Alex Santos"
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="FullName" class="text-[11px] text-rose-500"></span>
            </div>

            <div>
                <label asp-for="Identifier" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    Email Address or Phone Number *
                </label>
                <input asp-for="Identifier" placeholder="client@brand.com or +639123456789"
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="Identifier" class="text-[11px] text-rose-500"></span>
                <span class="text-[10px] text-slate-400 block mt-1">You can register using either your mobile number or your email address.</span>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    Create Password *
                </label>
                <input asp-for="Password" type="password" placeholder="At least 6 characters"
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="Password" class="text-[11px] text-rose-500"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    Confirm Password *
                </label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Repeat your password"
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="ConfirmPassword" class="text-[11px] text-rose-500"></span>
            </div>

            <button type="submit" class="w-full py-4 text-center text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 rounded-xl shadow-lg shadow-indigo-500/30 transition-all">
                Create Account &rarr;
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-slate-500">
            Already have an account? 
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-amber-500 hover:underline">
                Sign In &rarr;
            </a>
        </div>
    </div>
</div>
