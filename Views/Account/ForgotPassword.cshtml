@model MarkGraphiko.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset Password via Gmail | MARK GRAPHIKO";
}

<div class="max-w-md mx-auto px-6 py-12 md:py-16">
    <div class="rounded-3xl p-8 sm:p-10 glass-panel shadow-2xl relative border border-slate-200 dark:border-white/10">
        
        <div class="text-center mb-8">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-500 flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
            <h1 class="text-2xl font-black uppercase text-slate-900 dark:text-white tracking-tight">
                Reset Password
            </h1>
            <p class="text-xs text-slate-500 font-mono mt-1">
                Enter your Gmail / registered email to receive a 6-digit verification code
            </p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-rose-500"></div>

            <div>
                <label asp-for="Email" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    Gmail or Account Email Address *
                </label>
                <input asp-for="Email" type="email" placeholder="yourname@gmail.com" required
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="Email" class="text-[11px] text-rose-500"></span>
            </div>

            <button type="submit" class="w-full py-3.5 text-center text-xs font-bold uppercase tracking-wider text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center gap-2">
                <span>Send Code to Gmail</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-slate-500 space-y-2">
            <div>
                Remember your password? 
                <a asp-action="Login" class="font-bold text-indigo-500 hover:underline">
                    Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
