@{
    ViewData["Title"] = "Confirm Sign Out | MARK GRAPHIKO";
}

<div class="min-h-[75vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md p-8 sm:p-10 rounded-3xl glass-panel text-center shadow-2xl space-y-6">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-500 flex items-center justify-center">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
        </div>

        <div class="space-y-2">
            <h1 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight">
                Confirm Sign Out
            </h1>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                Are you sure you want to end your current session? You will need to sign in again to submit inquiries, view private chats, or manage portfolio designs.
            </p>
        </div>

        <div class="flex items-center gap-3 pt-2">
            <a asp-controller="Home" asp-action="Index" class="w-1/2 py-3 text-xs font-bold uppercase tracking-wider rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors text-center">
                Stay Signed In
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="w-1/2">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full py-3 text-xs font-bold uppercase tracking-wider rounded-xl text-white bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-500 hover:to-red-400 shadow-lg shadow-rose-500/30 transition-all">
                    Yes, Sign Out
                </button>
            </form>
        </div>
    </div>
</div>
