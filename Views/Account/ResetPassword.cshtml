@model MarkGraphiko.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Enter Verification Code & Set Password | MARK GRAPHIKO";
}

<div class="max-w-md mx-auto px-6 py-12 md:py-16">
    <div class="rounded-3xl p-8 sm:p-10 glass-panel shadow-2xl relative border border-slate-200 dark:border-white/10">
        
        <div class="text-center mb-8">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-500 flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h1 class="text-2xl font-black uppercase text-slate-900 dark:text-white tracking-tight">
                Verify &amp; Reset Password
            </h1>
            <p class="text-xs text-slate-500 font-mono mt-1">
                Enter the 6-digit code sent to your Gmail inbox
            </p>
        </div>

        <form asp-action="ResetPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-rose-500"></div>

            <div>
                <label asp-for="Email" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    Account Email *
                </label>
                <input asp-for="Email" type="email" readonly
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-500 dark:text-slate-400 border border-slate-300 dark:border-white/10 text-xs bg-slate-100 dark:bg-slate-800/60" />
                <span asp-validation-for="Email" class="text-[11px] text-rose-500"></span>
            </div>

            <div>
                <label asp-for="VerificationCode" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    6-Digit Verification Code *
                </label>
                <input asp-for="VerificationCode" maxlength="6" placeholder="e.g. 123456" autofocus required
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border-2 border-indigo-500 text-center tracking-[8px] font-mono font-bold text-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="VerificationCode" class="text-[11px] text-rose-500"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    New Password *
                </label>
                <input asp-for="NewPassword" type="password" placeholder="Minimum 6 characters" required
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="NewPassword" class="text-[11px] text-rose-500"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                    Confirm New Password *
                </label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Repeat new password" required
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="ConfirmPassword" class="text-[11px] text-rose-500"></span>
            </div>

            <button type="submit" class="w-full py-3.5 text-center text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 to-cyan-500 rounded-xl shadow-lg shadow-indigo-600/30 transition-all">
                Confirm &amp; Update Password
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-slate-500">
            Didn't receive the code? 
            <a asp-action="ForgotPassword" class="font-bold text-indigo-500 hover:underline">
                Request a new verification code &rarr;
            </a>
        </div>
    </div>
</div>
