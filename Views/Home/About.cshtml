@{
    ViewData["Title"] = "About & Skills | Mark Wilson Allado";
}

<div class="max-w-6xl mx-auto px-6 py-12 md:py-20">
    
    <!-- Top Bio Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20">
        <div class="lg:col-span-5 relative">
            <div class="relative rounded-3xl overflow-hidden glass-panel p-2 shadow-2xl">
                <!-- User's Official Profile Image -->
                <img src="~/images/mark-profile.jpg" alt="Mark Wilson Allado" class="w-full aspect-[4/5] object-cover rounded-2xl" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent rounded-2xl"></div>
                <div class="absolute bottom-6 left-6 right-6 text-white">
                    <span class="text-xs uppercase tracking-widest font-mono text-amber-400 font-bold">Creative Lead &bull; Visual Artist</span>
                    <h3 class="text-2xl font-black uppercase tracking-wide">MARK WILSON ALLADO</h3>
                    <p class="text-xs text-slate-300 font-mono mt-0.5">MARK GRAPHIKO &bull; Where Art Meets Design</p>
                </div>
            </div>
            <!-- Decorative badge with brand logo -->
            <div class="absolute -bottom-6 -right-6 hidden sm:flex items-center gap-3 p-4 rounded-2xl glass-panel shadow-2xl border border-amber-500/30 bg-slate-900/95 text-white">
                <img src="~/images/mark-graphiko-logo.png" alt="Logo" class="w-10 h-10 object-contain rounded-md" />
                <div>
                    <div class="text-[10px] font-mono text-amber-400 uppercase font-bold">Official Studio</div>
                    <div class="text-xs font-bold text-white">Mark Graphiko</div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-7">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-amber-500 block mb-2">The Brand Story</span>
            <h1 class="text-3xl sm:text-5xl font-black uppercase text-slate-900 dark:text-white tracking-tight leading-tight mb-6">
                WHERE ART MEETS <span class="gradient-text">DESIGN &amp; APPAREL</span>
            </h1>

            <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                Hello! I am <strong>Mark Wilson Allado</strong>, the creative mind and designer behind <strong>MARK GRAPHIKO</strong>. I specialize in crafting distinctive full-sublimation sportswear and school organization uniforms, bold streetwear apparel graphics, logos, and detailed vector art.
            </p>

            <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
                My signature design approach pairs cutting-edge digital aesthetics—from science-themed DNA helices and cyber gears to sleek minimal logos—with print-perfect technical execution in Adobe Photoshop and Canva. Every artwork is built with precision color palettes, custom typography locks, and production-ready print layouts.
            </p>

            <div class="flex flex-wrap gap-3">
                <span class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-amber-500/10 text-amber-500 border border-amber-500/20">Full Sublimation Uniforms</span>
                <span class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">Streetwear Silkscreen</span>
                <span class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">Vector Artworks</span>
                <span class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 border border-purple-500/20">Brand Insignias</span>
            </div>
        </div>
    </div>

    <!-- Software & Tools Stack Section -->
    <div class="glass-panel rounded-3xl p-8 md:p-12 mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-indigo-500 dark:text-indigo-400 block mb-2">Technical Proficiency</span>
            <h2 class="text-2xl sm:text-3xl font-black uppercase text-slate-900 dark:text-white">
                CREATIVE TOOLS &amp; WORKFLOW ARSENAL
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Tool 1: Photoshop -->
            <div class="p-6 rounded-2xl bg-slate-100/60 dark:bg-slate-800/40 border border-slate-200 dark:border-white/5">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <span class="w-9 h-9 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center">Ps</span>
                        <div>
                            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Adobe Photoshop</h4>
                            <span class="text-[11px] text-slate-400">Polo Sublimation Mockups, Apparel, Textures</span>
                        </div>
                    </div>
                    <span class="text-xs font-mono font-bold text-indigo-500">99%</span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full" style="width: 99%;"></div>
                </div>
            </div>

            <!-- Tool 2: Illustrator -->
            <div class="p-6 rounded-2xl bg-slate-100/60 dark:bg-slate-800/40 border border-slate-200 dark:border-white/5">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <span class="w-9 h-9 rounded-lg bg-amber-600 text-white font-bold text-xs flex items-center justify-center">Ai</span>
                        <div>
                            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Adobe Illustrator</h4>
                            <span class="text-[11px] text-slate-400">Vector Shapes, Emblems, Technical Separations</span>
                        </div>
                    </div>
                    <span class="text-xs font-mono font-bold text-amber-500">98%</span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full" style="width: 98%;"></div>
                </div>
            </div>
            
        </div>
    </div>

    <!-- Workflow Stages -->
    <div class="mb-12">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-indigo-500 dark:text-indigo-400 block mb-2">How We Collaborate</span>
            <h2 class="text-2xl sm:text-3xl font-black uppercase text-slate-900 dark:text-white">
                FROM CONCEPT BRIEF TO PRODUCTION MASTER
            </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="p-6 rounded-2xl glass-panel relative">
                <div class="text-3xl font-mono font-black text-amber-500/40 mb-3">01</div>
                <h4 class="font-bold text-base text-slate-900 dark:text-white mb-2">Concept &amp; Inspiration</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Analyzing theme, colors, organization badges, and apparel tailoring guidelines.
                </p>
            </div>
            <div class="p-6 rounded-2xl glass-panel relative">
                <div class="text-3xl font-mono font-black text-indigo-500/30 mb-3">02</div>
                <h4 class="font-bold text-base text-slate-900 dark:text-white mb-2">Vector &amp; Print Layout</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Drafting high-res vector graphics, DNA helixes, gears, and custom typography.
                </p>
            </div>
            <div class="p-6 rounded-2xl glass-panel relative">
                <div class="text-3xl font-mono font-black text-cyan-500/30 mb-3">03</div>
                <h4 class="font-bold text-base text-slate-900 dark:text-white mb-2">3D Sublimation Fitting</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Applying front, back, and sleeve patterns to hyper-realistic polo/tee mockups.
                </p>
            </div>
            <div class="p-6 rounded-2xl glass-panel relative">
                <div class="text-3xl font-mono font-black text-emerald-500/30 mb-3">04</div>
                <h4 class="font-bold text-base text-slate-900 dark:text-white mb-2">Full Handoff</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Delivering 300DPI production files ready for sublimation printing and silkscreen.
                </p>
            </div>
        </div>
    </div>

</div>
