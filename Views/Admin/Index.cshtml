@model MarkGraphiko.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Studio Dashboard | Mark Graphiko";
}

<div class="max-w-7xl mx-auto px-6 py-12">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200 dark:border-white/10">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                <span class="text-xs font-mono font-bold uppercase tracking-widest text-amber-500">Studio Management</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black uppercase text-slate-900 dark:text-white tracking-tight">
                ADMIN COMMAND CENTER
            </h1>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Upload" class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-600/30 transition-all">
                + Upload New Artwork
            </a>
            <a asp-action="Messages" class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-white glass-panel hover:border-indigo-500 transition-all">
                View Inbox (@Model.UnreadInquiries Unread)
            </a>
        </div>
    </div>

    <!-- Analytics Stat Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
        <div class="p-6 rounded-2xl glass-panel">
            <span class="text-xs font-mono font-bold uppercase text-slate-400 block mb-2">Total Artworks</span>
            <div class="text-3xl font-black text-slate-900 dark:text-white">@Model.TotalDesigns</div>
            <span class="text-[11px] text-emerald-500 mt-1 block">Live in Public Gallery</span>
        </div>
        <div class="p-6 rounded-2xl glass-panel">
            <span class="text-xs font-mono font-bold uppercase text-slate-400 block mb-2">Client Inquiries</span>
            <div class="text-3xl font-black text-indigo-500">@Model.TotalInquiries</div>
            <span class="text-[11px] text-slate-400 mt-1 block">@Model.UnreadInquiries awaiting reply</span>
        </div>
        <div class="p-6 rounded-2xl glass-panel">
            <span class="text-xs font-mono font-bold uppercase text-slate-400 block mb-2">Registered Clients</span>
            <div class="text-3xl font-black text-cyan-500">@Model.TotalUsers</div>
            <span class="text-[11px] text-slate-400 mt-1 block">Active user accounts</span>
        </div>
        <div class="p-6 rounded-2xl glass-panel">
            <span class="text-xs font-mono font-bold uppercase text-slate-400 block mb-2">Design Categories</span>
            <div class="text-3xl font-black text-purple-500">@Model.TotalCategories</div>
            <span class="text-[11px] text-slate-400 mt-1 block">Uniform, Logo, Poster</span>
        </div>
    </div>

    <!-- Dual Split: Recent Inquiries & Recent Uploads -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left: Recent Client Inquiries (7 Cols) -->
        <div class="lg:col-span-7 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-bold uppercase text-slate-900 dark:text-white tracking-tight">
                    Latest Client Inquiries
                </h2>
                <a asp-action="Messages" class="text-xs font-bold text-indigo-500 hover:underline">View All &rarr;</a>
            </div>

            <div class="space-y-3">
                @foreach (var msg in Model.RecentMessages)
                {
                    <div class="p-5 rounded-2xl glass-panel flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-xs font-bold text-slate-900 dark:text-white">@msg.SenderName</span>
                                <span class="text-[10px] text-slate-400 font-mono">(@msg.SenderEmail)</span>
                                @if (!msg.IsRead)
                                {
                                    <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase bg-amber-500/20 text-amber-500">Unread</span>
                                }
                            </div>
                            <h4 class="text-xs font-semibold text-slate-700 dark:text-slate-300">@msg.Subject</h4>
                            <p class="text-[11px] text-slate-500 line-clamp-1 mt-1">@msg.Content</p>
                        </div>

                        <div class="text-right shrink-0">
                            <span class="text-[10px] font-mono text-slate-400 block">@msg.SentAt.ToString("MMM dd, yyyy")</span>
                            <a asp-action="Messages" class="text-xs font-bold text-indigo-500 hover:underline mt-1 inline-block">
                                Open &amp; Reply &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Recent Portfolio Additions (5 Cols) -->
        <div class="lg:col-span-5 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-bold uppercase text-slate-900 dark:text-white tracking-tight">
                    Recently Uploaded
                </h2>
                <a asp-controller="Designs" asp-action="Index" class="text-xs font-bold text-indigo-500 hover:underline">Full Archive &rarr;</a>
            </div>

            <div class="space-y-3">
                @foreach (var design in Model.RecentDesigns)
                {
                    <div class="p-4 rounded-xl glass-panel flex items-center gap-4">
                        <img src="@design.ImagePath" alt="@design.Title" class="w-14 h-14 rounded-lg object-cover bg-black shrink-0" />
                        <div class="flex-grow min-w-0">
                            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">@design.Title</h4>
                            <span class="text-[10px] text-indigo-500 font-medium">@(design.Category?.Name ?? "Design")</span>
                            <span class="text-[10px] text-slate-400 font-mono block">@design.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@design.Id" class="p-2 text-slate-400 hover:text-indigo-500 transition-colors" title="Edit">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            </a>
                            <form asp-action="Delete" asp-route-id="@design.Id" method="post" onsubmit="return confirm('Delete this artwork?')" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="p-2 text-slate-400 hover:text-rose-500 transition-colors" title="Delete">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>

</div>
