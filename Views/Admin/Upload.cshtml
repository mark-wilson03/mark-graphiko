@model MarkGraphiko.Models.ViewModels.UploadDesignViewModel
@{
    ViewData["Title"] = "Upload Portfolio Artwork | Mark Graphiko Admin";
}

<div class="max-w-4xl mx-auto px-6 py-12">
    
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200 dark:border-white/10">
        <div>
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-indigo-500 block mb-1">Admin Studio Panel</span>
            <h1 class="text-2xl sm:text-3xl font-black uppercase text-slate-900 dark:text-white">
                @(Model.Id.HasValue ? "Edit Portfolio Piece" : "Upload New Design Piece")
            </h1>
        </div>
        <a asp-action="Index" class="text-xs font-bold uppercase text-slate-400 hover:text-indigo-500">
            &larr; Return to Dashboard
        </a>
    </div>

    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Upload")" method="post" enctype="multipart/form-data" class="space-y-8">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingImagePath" />
        <div asp-validation-summary="ModelOnly" class="text-xs text-rose-500"></div>

        <!-- High-Res File Upload Area with Instant Preview -->
        <div class="p-8 rounded-3xl glass-panel border-2 border-dashed border-slate-300 dark:border-white/10 text-center relative group hover:border-indigo-500 transition-colors">
            <div id="previewContainer" class="@(string.IsNullOrEmpty(Model.ExistingImagePath) ? "hidden" : "") mb-4 max-w-sm mx-auto">
                <img id="imagePreview" src="@Model.ExistingImagePath" alt="Preview" class="max-h-64 mx-auto rounded-xl object-contain shadow-lg" />
            </div>

            <div id="uploadPlaceholder" class="@(!string.IsNullOrEmpty(Model.ExistingImagePath) ? "hidden" : "")">
                <div class="w-14 h-14 mx-auto rounded-2xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center mb-3">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">
                    Select High-Resolution Artwork (PNG, JPG, WEBP)
                </h3>
                <p class="text-xs text-slate-400 max-w-xs mx-auto mb-4">
                    Recommended 300DPI or at least 1600x1200px for crisp client presentation.
                </p>
            </div>

            <input asp-for="ImageFile" type="file" accept="image/*" id="fileInput"
                   class="inline-block text-xs file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-600 file:text-white hover:file:bg-indigo-500 cursor-pointer" />
            <span asp-validation-for="ImageFile" class="text-[11px] text-rose-500 block mt-2"></span>
        </div>

        <!-- Metadata Form -->
        <div class="p-8 rounded-3xl glass-panel space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Title -->
                <div>
                    <label asp-for="Title" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Artwork Title</label>
                    <input asp-for="Title" placeholder="e.g. ORGANIZATION CLUB UNIFORM"
                           class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="Title" class="text-[11px] text-rose-500"></span>
                </div>

                <!-- Category -->
                <div>
                    <label asp-for="CategoryId" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Category</label>
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions"
                            class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white bg-transparent border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Client / Project -->
                <div>
                    <label asp-for="Client" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Client / Commission (Optional)</label>
                    <input asp-for="Client" placeholder="e.g. Mark Wilson Allado"
                           class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                </div>

                <!-- Tools Used -->
                <div>
                    <label asp-for="ToolsUsed" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Tools Used</label>
                    <input asp-for="ToolsUsed" placeholder="Adobe Photoshop"
                           class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                </div>
            </div>

            <!-- Tags -->
            <div>
                <label asp-for="Tags" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Search Tags (Comma separated)</label>
                <input asp-for="Tags" placeholder="streetwear, apparel, cyberpunk, vector, oversized"
                       class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Artwork Details &amp; Design Notes</label>
                <textarea asp-for="Description" rows="4" placeholder="Detail the silhouette, silkscreen layer count, typography inspiration, and fabric weight..."
                          class="w-full px-4 py-3 rounded-xl glass-panel text-slate-900 dark:text-white border border-slate-300 dark:border-white/10 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none leading-relaxed"></textarea>
            </div>

            <!-- IsFeatured Checkbox -->
            <div class="flex items-center gap-3 p-4 rounded-xl bg-slate-100/60 dark:bg-slate-800/40 border border-slate-200 dark:border-white/5">
                <input asp-for="IsFeatured" type="checkbox" id="isFeaturedCheck" class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" />
                <label for="isFeaturedCheck" class="text-xs font-semibold text-slate-800 dark:text-slate-200 cursor-pointer">
                    Feature on Homepage Carousel &amp; Highlights (Top Showcase)
                </label>
            </div>

            <button type="submit" class="w-full py-4 text-center text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 to-cyan-500 rounded-xl hover:shadow-xl hover:shadow-indigo-500/30 transition-all">
                @(Model.Id.HasValue ? "Save Artwork Updates" : "Publish to Portfolio Archive") &rarr;
            </button>
        </div>
    </form>

</div>

@section Scripts {
    <script>
        const fileInput = document.getElementById('fileInput');
        const previewContainer = document.getElementById('previewContainer');
        const imagePreview = document.getElementById('imagePreview');
        const uploadPlaceholder = document.getElementById('uploadPlaceholder');

        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        imagePreview.src = evt.target.result;
                        previewContainer.classList.remove('hidden');
                        uploadPlaceholder.classList.add('hidden');
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
    </script>
}
