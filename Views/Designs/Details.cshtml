@model MarkGraphiko.Models.DesignPost
@{
    ViewData["Title"] = Model.Title;
}

<div class="max-w-5xl mx-auto px-6 py-12">
    <!-- Back to gallery -->
    <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-500 hover:text-indigo-400 mb-8">
        &larr; Back to Design Archive
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 rounded-2xl overflow-hidden glass-panel p-2 shadow-2xl bg-black">
            <img src="@Model.ImagePath" alt="@Model.Title" class="w-full h-auto object-contain rounded-xl" />
        </div>

        <div class="lg:col-span-5 p-6 rounded-2xl glass-panel space-y-6">
            <div>
                <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-indigo-500/10 text-indigo-500 dark:text-indigo-400 border border-indigo-500/20 mb-3">
                    @(Model.Category?.Name ?? "Design")
                </span>
                <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mb-3">
                    @Model.Title
                </h1>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    @Model.Description
                </p>
            </div>

            <div class="space-y-3 py-4 border-y border-slate-200 dark:border-white/10 text-xs">
                <div>
                    <span class="text-slate-400 font-medium">Client / Project:</span>
                    <span class="text-slate-800 dark:text-slate-200 font-semibold ml-2">@(Model.Client ?? "Studio Edition")</span>
                </div>
                <div>
                    <span class="text-slate-400 font-medium">Tools Used:</span>
                    <span class="text-slate-800 dark:text-slate-200 font-semibold ml-2">@(Model.ToolsUsed ?? "Photoshop, Illustrator")</span>
                </div>
                <div>
                    <span class="text-slate-400 font-medium">Release Date:</span>
                    <span class="text-slate-800 dark:text-slate-200 font-semibold ml-2">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>

            <div class="pt-2">
                <a asp-controller="Message" asp-action="Index" asp-route-designId="@Model.Id" class="block w-full py-4 text-center text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 to-cyan-500 rounded-xl shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 transition-all">
                    Inquire About This Style
                </a>
            </div>
        </div>
    </div>
</div>
